# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shop"

# Random string, 32+ chars (openssl rand -base64 32). Signs the admin session cookie.
AUTH_SECRET=""

# First admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"

# Telegram order alerts (see README). Leave empty to disable.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Public URL of the site, used for links inside Telegram messages
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
